# Veritabanı
POSTGRES_USER=emlak
POSTGRES_PASSWORD=emlak_dev_password
POSTGRES_DB=emlak_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://emlak:emlak_dev_password@localhost:5432/emlak_db

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=emlak_tahmin

# Scraper
SCRAPER_USER_AGENT=EmlakTahminBot/1.0 (Bitirme Projesi; iletisim@example.com)
SCRAPER_DOWNLOAD_DELAY=3
SCRAPER_CONCURRENT_REQUESTS=2

# TCMB EVDS API (enflasyon verisi)
EVDS_API_KEY=your_evds_key_here

# Frontend
VITE_API_BASE_URL=http://localhost:8000
